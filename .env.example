# Claude (required). Or use `ant auth login` instead of an API key.
ANTHROPIC_API_KEY=
OPUSVIDEO_MODEL=claude-opus-5-5
OPUSVIDEO_WRITING_EFFORT=high
OPUSVIDEO_JUDGING_EFFORT=medium

# Media: "mock" (offline, free) or "replicate"
OPUSVIDEO_MEDIA=mock
OPUSVIDEO_ASPECT=16:9

# Replicate (only for OPUSVIDEO_MEDIA=replicate). Check each model's API page for its input names.
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
REPLICATE_REF_IMAGE_FIELD=
REPLICATE_VIDEO_MODEL=kwaivgi/kling-v2.1
REPLICATE_VIDEO_IMAGE_FIELD=start_image
